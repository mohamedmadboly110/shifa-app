# ---------------------------------------------------------------------------
# Shifa API - environment variables
# Copy to `.env` and fill in real values.  NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database
MONGO_URI=mongo-uri

# Auth
# Minimum 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=1d

# QR / check-in token signing secret (falls back to JWT_SECRET when unset)
CHECKIN_TOKEN_SECRET=
# How long a check-in ticket stays valid (appointment day + grace period)
CHECKIN_TOKEN_TTL_HOURS=36

# Security
# Comma separated list of allowed origins, or * for any (development only)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Comma separated list of trusted proxy hops (0 = none)
TRUST_PROXY=0

# Business rules
# Default appointment slot length in minutes
SLOT_DURATION_MINUTES=30
# A slot is considered booked once its start time is closer than this (minutes)
BOOKING_CUTOFF_MINUTES=60
# Patients may cancel until this many minutes before the appointment starts
CANCELLATION_CUTOFF_MINUTES=60
# Currency used for consultation fees
DEFAULT_CURRENCY=EGP

# Rate limiting (auth endpoints)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Seed script guard: only allow destructive seeding outside production
SEED_ALLOW_NON_PRODUCTION=true
